{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "github-actions"],
  "packageRules": [
    {
      "description": "Stay on TypeScript 6; allow 6.x minors and patches, block 7+",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Group TypeScript/npm updates into a single PR and refresh the committed action bundle",
      "matchManagers": ["npm"],
      "groupName": "typescript dependencies",
      "separateMajorMinor": false,
      "skipInstalls": false,
      "postUpgradeTasks": {
        "commands": ["pnpm install", "pnpm bundle"],
        "fileFilters": ["dist/**"],
        "executionMode": "branch",
        "installTools": {
          "node": {},
          "pnpm": {}
        }
      }
    },
    {
      "description": "Group GitHub Actions updates into a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "separateMajorMinor": false
    }
  ]
}
